# Credentials for the Rome Future Week scripts.
#
# Copy to .env, fill in your own values, then source it:
#
#     cp .env.example .env
#     . ./.env
#
# .env is gitignored; .env.example is not. Never put real values in this file.

# --- Earth Data Hub, used by urban_heat/ ---------------------------------------
# API key from your DESP account settings: https://earthdatahub.destine.eu
# Climate DT is restricted data and needs upgraded DESP access.
# Can also be passed with --api-key.
export EDH_API_KEY=

# --- DESP login, used by flood/ ------------------------------------------------
# Your destine.eu account username and password. The flood scripts exchange these
# for an HDA token via destinepyauth (get_token("hda")), so no separate API key.
export DESPAUTH_USER=
export DESPAUTH_PASSWORD=
