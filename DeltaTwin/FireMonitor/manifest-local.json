{
  "name": "fire-monitor",
  "description": "Active Fire Monitor component that downloads MTG FCI Active Fire Level-2 products from HDA and generates an active fire classification plot for a selected NUTS2 region.",
  "license": {
    "name": "LGPLv3",
    "url": "https://www.gnu.org/licenses/gpl-3.0.txt",
    "description": "",
    "copyrights": [
      {
        "years": [2026],
        "company": "Serco"
      }
    ]
  },
  "owner": "Serco",

  "inputs": {
    "user": {
      "type": "string",
      "description": "DestinE Service Platform User Credentials."
    },
    "password": {
      "type": "string",
      "description": "DestinE Service Platform Password Credentials."
    },
    "nuts2_region_name": {
      "type": "string",
      "description": "NUTS2 region name to monitor, e.g. 'Galicia' or 'Ile-de-France'."
    },
    "download_date": {
      "type": "string",
      "description": "End date for the FCI Active Fire product search in YYYY-MM-DD format. If left as 'none' it will default to today.",
      "value": "none"
    }
  },

  "outputs": {
    "fire-monitor-plot": {
      "type": "Data",
      "description": "PNG plot showing Active Fire Classification for the selected NUTS2 region."
    }
  },

  "models": {
    "fire_monitor": {
      "path": "models/fire_monitor",
      "type": "python",
      "parameters": {
        "pythonVersion": "3.11",
        "aptRequirements": [
          {
            "name": "libexpat1"
          },
          {
            "name": "libexpat1-dev"
          }
        ],
        "pipRequirements": [
          {
            "name": "destinepyauth",
            "version": "1.3.1"
          },
          {
            "name": "geopandas"
          },
          {
            "name": "matplotlib"
          },
          {
            "name": "numpy"
          },
          {
            "name": "pyproj"
          },
          {
            "name": "requests"
          },
          {
            "name": "tqdm"
          },
          {
            "name": "xarray"
          },
          {
            "name": "h5netcdf"
          },
          {
            "name": "h5py"
          },
          {
            "name": "cartopy"
          }
        ],
        "hardwareRequirements": {
          "cpu": "4000m",
          "ram": "8Gi"
        },
        "command": "python fire_monitor.py $(inputs.user) $(inputs.password) $(inputs.nuts2_region_name) $(inputs.download_date)"
      },
      "inputs": {
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "nuts2_region_name": {
          "type": "string"
        },
        "download_date": {
          "type": "string",
          "value": "none"
        }
      },
      "outputs": {
        "fire-monitor-plot": {
          "type": "Data",
          "glob": "fire_monitor_plot.png"
        }
      }
    }
  },

  "dependencies": {}
}
