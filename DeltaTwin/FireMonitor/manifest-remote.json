{
  "name": "fire-monitor",
  "description": "Active Fire Monitor component that downloads MTG FCI Active Fire Level-2 products from HDA and generates a fire probability and classification plot for a selected country.",
  "license": {
    "name": "LGPLv3",
    "url": "https://www.gnu.org/licenses/gpl-3.0.txt",
    "description": "",
    "copyrights": [
      {
        "years": [2026],
        "company": "Serco"
      }
    ]
  },
  "owner": "Serco",

  "inputs": {
    "user": {
      "type": "string",
      "description": "DestinE Service Platform User Credentials."
    },
    "password": {
      "type": "secret",
      "description": "DestinE Service Platform Password Credentials."
    },
    "country_name": {
      "type": "string",
      "description": "Country name to monitor, e.g. 'Spain' or 'Italy'."
    },
    "download_date": {
      "type": "string",
      "description": "End date for the FCI Active Fire product search in YYYY-MM-DD format."
    }
  },

  "outputs": {
    "fire-monitor-plot": {
      "type": "Data",
      "description": "PNG plot showing Fire Probability and Active Fire Classification for the selected country."
    }
  },

  "models": {
    "fire_monitor": {
      "path": "models/fire_monitor",
      "type": "python",
      "parameters": {
        "pythonVersion": "3.11",
        "aptRequirements": [
          {
            "name": "libexpat1"
          },
          {
            "name": "libexpat1-dev"
          }
        ],
        "pipRequirements": [
          {
            "name": "destinepyauth",
            "version": "1.3.0"
          },
          {
            "name": "geopandas"
          },
          {
            "name": "matplotlib"
          },
          {
            "name": "numpy"
          },
          {
            "name": "pyproj"
          },
          {
            "name": "requests"
          },
          {
            "name": "tqdm"
          },
          {
            "name": "xarray"
          }
        ],
        "hardwareRequirements": {
          "cpu": "4000m",
          "ram": "8Gi"
        },
        "command": "python fire_monitor.py $(inputs.user) $(inputs.password) $(inputs.country_name) $(inputs.download_date)"
      },
      "inputs": {
        "user": {
          "type": "string"
        },
        "password": {
          "type": "secret"
        },
        "country_name": {
          "type": "string"
        },
        "download_date": {
          "type": "string"
        }
      },
      "outputs": {
        "fire-monitor-plot": {
          "type": "Data",
          "glob": "fire_monitor_plot.png"
        }
      }
    }
  },

  "dependencies": {}
}
